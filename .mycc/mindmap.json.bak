                    "comment": "Child requestGrant: sends IPC 'grant_request' to parent"
                  },
                  {
                    "target_type": "term",
                    "term_name": "Intent Language",
                    "comment": "VERB OBJECT PARAM... TO PURPOSE DSL required by bash/hand_over tools; verbs READ/WRITE/EDIT/DELETE/FIND/BUILD/TEST/INSTALL/RUN, objects SOURCE/CONFIG/DEPENDENCY/ARTIFACT/SYSTEM/DATA/TEMP/USER"
                  },
                  {
                    "target_type": "term",
                    "term_name": "dangerous=i_know",
                    "comment": "Reserved intent PARAM escape hatch for destructive/irreversible commands: skips hard block AND LLM safeguard, routes directly to user [y/N]. Unavailable in child processes."
                  },
                  {
                    "target_type": "term",
                    "term_name": "batch=i_know",
                    "comment": "Reserved intent PARAM that skips the LLM safeguard for batch deletions, routing directly to user [y/N]. Only affects DELETE+batch-delete path. Unavailable in child processes."
                  },
                  {
                    "target_type": "term",
                    "term_name": "Socratic hint",
                    "comment": "Blocked-command message naming the existence of a PARAM override but withholding the exact key/value, forcing the LLM to re-derive it."
                  }
                ]
              }
