{
  "name": "@pkubangbang/mycc",
  "version": "0.11.11",
  "description": "Node.js agent implementations using Ollama - harness engineering for AI agents",
  "type": "module",
  "private": true,
  "bin": {
    "mycc": "./bin/mycc.js",
    "mdcalc": "./scripts/mdcalc/mdcalc.js",
    "mycc-mail": "./scripts/mycc-mail/mycc-mail.js",
    "mycc-compose": "./scripts/mycc-compose/mycc-compose.js",
    "mycc-stop": "./scripts/mycc-stop/mycc-stop.js",
    "mycc-pretty-print": "./scripts/pretty-print/pretty-print.js"
  },
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "lint": "vp check",
    "test": "vp test run",
    "test:tty": "cross-env MYCC_TTY_TESTS=1 vp test run src/tests/plain-output.test.ts",
    "test:slow": "cross-env RUN_SLOW=1 vp test run",
    "prepare": "vp config || echo \"[prepare] vp unavailable (production install) - skipping dev tooling setup\""
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@pkubangbang/crossroad-detector": "0.2.1",
    "@pkubangbang/filesync-manager": "^0.1.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "chalk": "^6.0.0",
    "chokidar": "^6.0.0",
    "croner": "^10.0.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "jsep": "^1.4.0",
    "markdown-it": "^15.0.2",
    "minimist": "^1.2.8",
    "pinia": "^4.0.3",
    "ripgrep": "^0.3.1",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.23.13",
    "vite": "catalog:",
    "vue": "^3.5.42",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.13.5",
    "@types/ws": "^8.18.1",
    "chai": "^6.2.2",
    "typescript": "^5.9.3",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
