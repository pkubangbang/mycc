{
  "name": "@pkubangbang/mycc",
  "version": "0.11.3",
  "description": "Node.js agent implementations using Ollama - harness engineering for AI agents",
  "type": "module",
  "private": true,
  "bin": {
    "mycc": "./bin/mycc.js",
    "mdcalc": "./scripts/mdcalc/mdcalc.js",
    "mycc-mail": "./scripts/mycc-mail/mycc-mail.js",
    "mycc-pretty-print": "./scripts/pretty-print/pretty-print.js"
  },
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "npm run typecheck && npm run typecheck:test && npm run typecheck:web && vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:web": "vue-tsc --noEmit -p src/web/tsconfig.json",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@pkubangbang/crossroad-detector": "^0.1.3",
    "@lancedb/lancedb": "^0.27.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "chalk": "^6.0.0",
    "croner": "^10.0.1",
    "express": "^5.2.1",
    "gray-matter": "^4.0.3",
    "jsep": "^1.4.0",
    "markdown-it": "^15.0.2",
    "minimist": "^1.2.8",
    "ollama": "^0.6.3",
    "pinia": "^4.0.3",
    "ripgrep": "^0.3.1",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.23.13",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/json-schema": "^7.0.15",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.13.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  }
}
