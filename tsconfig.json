{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true,
    // `node` only. `vitest/globals` is intentionally NOT listed: vitest is a
    // devDependency, and naming it here breaks the compiler in a production-
    // only install (`pnpm install --prod`), which is the supported way to run
    // mycc without dev tooling. The entry was also vestigial — every test file
    // imports its globals explicitly from 'vite-plus/test'.
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // src/web/** is a separate Vue project whose .vue SFCs no command type-checks
  // (vue-tsc was removed; vp check cannot parse SFCs). Lint/format rules still
  // apply to it via vite.config.ts. src/tests/** IS included here so that
  // `vp check`'s type-check covers the test suite — the regression this file
  // used to miss (see precommit-verify skill).
  "exclude": ["node_modules", "src/web/**/*"]
}
